# Committed defaults, loaded last so anything already set wins.
#
# `.env` and `.env.local` are gitignored, so a default cannot live there; and
# `${PORT:-3002}` in a package script is not an option because Bun's own shell
# — which `bun run` uses on Windows — does not implement default-value
# parameter expansion and passes the literal through to Next.
#
# Precedence: shell PORT > .env.local > this file.

# Dev server port for apps/editor.
PORT=3002

# Server-only AI defaults. OPENAI_API_KEY belongs in .env.local, never in NEXT_PUBLIC_*.
DIASTAGE_COMMAND_MODEL=gpt-5.6-luna
DIASTAGE_SCRIPT_MODEL=gpt-5.6-luna
DIASTAGE_TRANSCRIBE_MODEL=gpt-transcribe
DIASTAGE_USD_CNY_REFERENCE=7.00
DIASTAGE_AI_COMMAND_SOFT_LIMIT_CNY=0.05
DIASTAGE_AI_VOICE_SOFT_LIMIT_CNY=0.10
DIASTAGE_AI_SCRIPT_SOFT_LIMIT_CNY=0.50
DIASTAGE_AI_SCRIPT_HARD_LIMIT_CNY=1.00
DIASTAGE_AI_MONTHLY_USER_LIMIT_CNY=10.00
DIASTAGE_AI_CREATE_MODE_TTL_MINUTES=30
DIASTAGE_AI_CREATE_MODE_MAX_NODES_PER_TRANSACTION=20
