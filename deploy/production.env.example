NODE_ENV=production
# Set to the exact source commit from the release manifest before an approved switch.
PASCAL_RUNTIME_VERSION=
PASCAL_DB_PATH=/home/ubuntu/diastage-data/scenes.db
DIASTAGE_AI_LEDGER_PATH=/home/ubuntu/diastage-data/ai-usage.db
BETTER_AUTH_URL=https://diastage.art
MINT_PASCAL_HOST_ORIGIN=https://diastage.art
BETTER_AUTH_SECRET=
# Server-only operator key. Leave blank until real AI use is approved and verified.
OPENAI_API_KEY=
# Set only after explicitly approving each registered account (not email addresses).
DIASTAGE_AI_BETA_USER_IDS=
# Server-only Tencent Cloud SES API. Enable only after DNS, templates and delivery checks.
DIASTAGE_AUTH_EMAIL_ENABLED=false
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# Match the SES console region: ap-guangzhou or ap-hongkong.
TENCENT_SES_REGION=
TENCENT_SES_FROM_EMAIL=
# Optional. Set only after the reply mailbox is verified and the operator confirms it.
TENCENT_SES_REPLY_TO_EMAIL=
TENCENT_SES_RESET_TEMPLATE_ID=
TENCENT_SES_VERIFY_TEMPLATE_ID=
