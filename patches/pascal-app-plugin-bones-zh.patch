diff --git a/src/engineering-labels.test.ts b/src/engineering-labels.test.ts
new file mode 100644
--- /dev/null
+++ b/src/engineering-labels.test.ts
@@ -0,0 +1,146 @@
+import { expect, test } from 'bun:test'
+import { engineeringLabel } from './engineering-labels'
+import { baselineConfig, baselineScene } from './framing/baseline-scene'
+import { computeLevel } from './framing/compute'
+import { groupWarnings } from './panel-warnings'
+
+test('engineering display translates known labels without changing grouping, numbers or unknown names', () => {
+  expect(engineeringLabel('Wall framing')).toBe('墙体框架')
+  expect(engineeringLabel('Design heat loss (dT 30K)')).toBe('设计热损失（温差 30 K）')
+  expect(engineeringLabel('Circuit C12')).toBe('回路 C12')
+  expect(engineeringLabel('R602.10.6.4')).toBe('R602.10.6.4')
+  expect(engineeringLabel('我自己的房间 A')).toBe('我自己的房间 A')
+  expect(engineeringLabel('Roof garden take 2')).toBe('Roof garden take 2')
+  expect(engineeringLabel('Canada · Quebec')).toBe('加拿大·魁北克')
+  const warnings = ['braced wall line X1: inspect', 'braced wall line X2: inspect']
+  const grouped = groupWarnings(warnings)
+  expect(grouped).toEqual([
+    { kind: 'group', label: 'braced wall lines', message: 'inspect', warnings },
+  ])
+  expect(engineeringLabel(grouped[0]!.kind === 'group' ? grouped[0].label : '')).toBe('抗侧力墙线')
+  expect(warnings).toEqual(['braced wall line X1: inspect', 'braced wall line X2: inspect'])
+})
+
+test('real bracing warnings translate after grouping without changing engine data', () => {
+  const result = computeLevel(baselineScene(), baselineConfig('CA'))
+  const before = JSON.stringify(result)
+  const warnings = result.warnings.filter((warning) => warning.startsWith('braced wall line'))
+  expect(warnings).toHaveLength(4)
+  const rows = groupWarnings(warnings)
+  expect(rows).toHaveLength(1)
+  const row = rows[0]!
+  expect(row.kind).toBe('group')
+  if (row.kind !== 'group') throw new Error('expected the actual braced-line warning group')
+  expect(engineeringLabel(row.label)).toBe('抗侧力墙线')
+  expect(engineeringLabel(row.message)).toBe(
+    '假定采用 CS-WSP 连续覆面板；尚未核实 R602.10 要求的板段长度与间距',
+  )
+  expect(engineeringLabel(row.warnings[0]!)).toBe(
+    '抗侧力墙线 X1（1 面墙，12.0 m）：假定采用 CS-WSP 连续覆面板；尚未核实 R602.10 要求的板段长度与间距',
+  )
+  expect(result.characteristics?.notes.length).toBeGreaterThan(0)
+  for (const note of result.characteristics?.notes ?? []) {
+    expect(engineeringLabel(note)).toMatch(/[\u4e00-\u9fff]/)
+  }
+  expect(JSON.stringify(result)).toBe(before)
+  expect(groupWarnings(warnings)).toEqual(rows)
+})
+
+test('priority HVAC warnings and room-derived service states translate explicitly', () => {
+  expect(engineeringLabel('no exterior wall — condenser row placed at the anchor, verify')).toBe(
+    '未找到外墙；冷凝器排列在锚点处，请核查位置',
+  )
+  expect(
+    engineeringLabel(
+      'no indoor zones on this level — HVAC + plumbing are derived from rooms; draw zones here or X-ray the storey that has them',
+    ),
+  ).toBe(
+    '本层没有室内区域；暖通空调与给排水根据房间生成，请在此绘制区域，或切换至已有区域的楼层查看内部构造',
+  )
+  expect(
+    engineeringLabel(
+      'installed 3.5 tons = 120% of the 2.92-ton Manual J-lite load — exceeds the Manual S 115% band (stock unit steps after the ≤5-ton split); verify selection',
+    ),
+  ).toBe(
+    '安装制冷量 3.5 冷吨为 2.92 冷吨简化 Manual J 负荷的 120%，超过 Manual S 115% 上限（按单机不超过 5 冷吨拆分后的常用设备规格），请核查选型',
+  )
+})
+
+test('known warning templates preserve user names and ids verbatim', () => {
+  const name = 'Duct Studio / 我自己的 fittings'
+  expect(engineeringLabel(`Room "${name}" has no floor slab under it`)).toBe(
+    `房间“${name}”下方没有楼板`,
+  )
+  expect(
+    engineeringLabel(
+      `return grille cannot fully clear the supply ducts in ${name} — verify placement`,
+    ),
+  ).toBe(`回风格栅无法完全避开“${name}”内的送风管，请核查位置`)
+  expect(
+    engineeringLabel(
+      `duplicate zone “${name}” shares “Roof garden 2”'s polygon — merged (classified once, not twice)`,
+    ),
+  ).toBe(`重复区域“${name}”与“Roof garden 2”共用轮廓，已合并且仅分类一次`)
+  expect(
+    engineeringLabel(
+      `device “${name}”: mount height clamped to 2.00 m — switches live in [0.9, 2] m (NEC 404.8(A) 6'7" max)`,
+    ),
+  ).toBe(
+    `设备“${name}”：安装高度已限制为 2.00 m；开关安装范围为 [0.9, 2] m（NEC 404.8(A)，最高 6 英尺 7 英寸）`,
+  )
+  expect(
+    engineeringLabel(
+      `device “${name}”: mount height clamped to 0.45 m — receptacles live in [0.3, 0.45] m`,
+    ),
+  ).toBe(`设备“${name}”：安装高度已限制为 0.45 m；插座安装范围为 [0.3, 0.45] m`)
+})
+
+test('quantity descriptions keep counts, allowances and technical references', () => {
+  expect(
+    engineeringLabel(
+      '20 ft stock (field splice — run exceeds 20 ft) (pressure-treated) — +5% waste ≈ 14 pcs',
+    ),
+  ).toBe('20 英尺定尺料（现场拼接，连续长度超过 20 英尺）（加压防腐处理），增加 5% 损耗后约 14 件')
+  expect(
+    engineeringLabel(
+      'footings — +5% waste ≈ 0.4 yd³ (waste smaller than the 0.1 yd³ display step — net and order figures meet at display rounding)',
+    ),
+  ).toBe(
+    '基础，增加 5% 损耗后约 0.4 yd³（损耗小于 0.1 yd³ 显示步长，净用量与订货量在显示舍入后相同）',
+  )
+  expect(
+    engineeringLabel(
+      'deck panels, from members (~28 4x8 sheets, R803.2) — +10% waste ≈ 31 sheets; tapered planes conservatively under-tiled (see member labels) — shortfall NOT covered by the stated waste',
+    ),
+  ).toBe(
+    '按构件统计屋面板（约 28 张 4×8 板材，R803.2），增加 10% 损耗后约 31 张；渐缩面按保守方式少铺板材（见构件标签），此缺额未包含在上述损耗中',
+  )
+  expect(
+    engineeringLabel(
+      'ASTM C1513 — 2 per flange pair, both member ends (Table R603.3.2(1)); 12 verticals × 4',
+    ),
+  ).toBe('ASTM C1513：每对翼缘 2 枚，构件两端均设置（表 R603.3.2(1)）；12 根竖向构件 × 4')
+  expect(
+    engineeringLabel(
+      '@ 6" edges / 12" field (R603.2.5) — 14 steel-wall sheets × 53 (4x8 vertical, 16" o.c. assumed)',
+    ),
+  ).toBe(
+    '板边间距 6 英寸、板中间距 12 英寸（R603.2.5）；14 张钢框架墙板 × 53（4×8 板材竖向安装，假定立柱中心间距 16 英寸）',
+  )
+  expect(engineeringLabel('1 × 1 m × 4" concrete equipment pad (40"-class stock; IRC M1403)')).toBe(
+    '1 × 1 m × 4 英寸混凝土设备基础垫块（40 英寸级常用规格，IRC M1403）',
+  )
+})
+
+test('unknown technical diagnostics and arbitrary text stay intact', () => {
+  for (const value of [
+    'constructor',
+    'toString',
+    '__proto__',
+    'Custom assembly — +5% waste ≈ 4.2 yd³',
+    'prefix no exterior wall — condenser row placed at the anchor, verify',
+    'wall custom_A: unknown detail — verify 2.17m per R602.10',
+    'R603.3.2(1)',
+  ])
+    expect(engineeringLabel(value)).toBe(value)
+})
