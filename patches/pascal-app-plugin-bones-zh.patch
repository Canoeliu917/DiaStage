+export function engineeringLabel(value: string): string {
+  if (Object.hasOwn(labels, value)) return labels[value]!
+
+  // Match whole engine messages, preserving instance ids and user-authored names.
+  const bracedLine = /^braced wall line (\S+) \((\d+) walls?, ([\d.]+)m\): (.+)$/.exec(value)
+  if (bracedLine) {
+    return `抗侧力墙线 ${bracedLine[1]}（${bracedLine[2]} 面墙，${bracedLine[3]} m）：${engineeringLabel(bracedLine[4]!)}`
+  }
+  const stock =
+    /^(\d+(?:\.\d+)?) ft stock( \(field splice — run exceeds 20 ft\))?( \(pressure-treated\))?(?: — \+(\d+(?:\.\d+)?%) waste ≈ (\d+) pcs)?$/.exec(
+      value,
+    )
+  if (stock) {
+    return `${stock[1]} 英尺定尺料${stock[2] ? '（现场拼接，连续长度超过 20 英尺）' : ''}${stock[3] ? '（加压防腐处理）' : ''}${stock[4] ? `，增加 ${stock[4]} 损耗后约 ${stock[5]} 件` : ''}`
+  }
+  const pour =
+    /^(.+) — \+(\d+(?:\.\d+)?%) waste ≈ ([\d.]+) yd³( \(waste smaller than the 0\.1 yd³ display step — net and order figures meet at display rounding\))?$/.exec(
+      value,
+    )
+  if (pour && Object.hasOwn(labels, pour[1]!)) {
+    return `${labels[pour[1]!]}，增加 ${pour[2]} 损耗后约 ${pour[3]} yd³${pour[4] ? '（损耗小于 0.1 yd³ 显示步长，净用量与订货量在显示舍入后相同）' : ''}`
+  }
+  const knownMessage = value
+    .replace(/^Room "([\s\S]+)" has no floor slab under it$/, '房间“$1”下方没有楼板')
+    .replace(
+      /^duplicate zone “([\s\S]+)” shares “([\s\S]+)”'s polygon — merged \(classified once, not twice\)$/,
+      '重复区域“$1”与“$2”共用轮廓，已合并且仅分类一次',
+    )
+    .replace(
+      /^zone “([\s\S]+)” reads as open-air — no smoke alarm placed \(R314\); rename if it is conditioned space$/,
+      '区域“$1”被识别为露天空间，未放置感烟报警器（R314）；若为空调空间，请更改名称',
+    )
+    .replace(
+      /^(\d+) duplicate overlapping walls? skipped \(framed once, not twice\)$/,
+      '已跳过 $1 面重复重叠墙，框架仅生成一次',
+    )
+    .replace(
+      /^(\d+) mixed CMU\/framed walls?: assembly layers follow the CMU treatment for the whole wall \(v1\)$/,
+      '$1 面混合砌块 / 框架墙的全部构造层按混凝土砌块处理（v1）',
+    )
+    .replace(
+      /^duplicate service point \(([\s\S]+)\) — extra node ignored$/,
+      '存在重复的入户服务点（$1），已忽略多余节点',
+    )
+    .replace(
+      /^duplicate device node \(([\s\S]+)\) — extra node ignored$/,
+      '存在重复设备节点（$1），已忽略多余节点',
+    )
+    .replace(
+      /^return grille cannot fully clear the supply ducts in ([\s\S]+) — verify placement$/,
+      '回风格栅无法完全避开“$1”内的送风管，请核查位置',
+    )
+    .replace(
+      /^return drop cannot clear walls in ([\s\S]+) — verify routing$/,
+      '回风下引管无法避开“$1”内的墙体，请核查路径',
+    )
+    .replace(
+      /^heat-pump point is inside ([\s\S]+) — the outdoor unit belongs outside; move it or it will be drawn indoors$/,
+      '热泵点位位于“$1”内；室外机应位于室外，请移动点位，否则设备将绘制在室内',
+    )
+    .replace(
+      /^heat-pump point is ([\d.]+) m from the nearest exterior wall — beyond the 25 ft service reach \(NEC 210\.63\); verify the outdoor unit's spot$/,
+      '热泵点位距最近外墙 $1 m，超过 25 英尺检修服务距离（NEC 210.63），请核查室外机位置',
+    )
+    .replace(
+      /^AC disconnect #(\d+) sits in a door\/window rough opening — move the unit clear \(NEC 440\.14\)$/,
+      '第 $1 个空调隔离开关位于门窗预留洞口内，请移开设备（NEC 440.14）',
+    )
+    .replace(
+      /^device “([\s\S]+)”: override wall ([\s\S]+) is not framed — using the derived spot$/,
+      '设备“$1”：指定的墙体 $2 尚未生成框架，改用推导位置',
+    )
+    .replace(
+      /^device “([\s\S]+)” sits in a door\/window rough opening — snapped clear$/,
+      '设备“$1”位于门窗预留洞口内，已吸附至避让位置',
+    )
+    .replace(
+      /^device “([\s\S]+)”: mount height clamped to ([\d.]+) m — switches live in \[([\d.]+), ([\d.]+)\] m \(NEC 404\.8\(A\) 6'7" max\)$/,
+      '设备“$1”：安装高度已限制为 $2 m；开关安装范围为 [$3, $4] m（NEC 404.8(A)，最高 6 英尺 7 英寸）',
+    )
+    .replace(
+      /^device “([\s\S]+)”: mount height clamped to ([\d.]+) m — receptacles live in \[([\d.]+), ([\d.]+)\] m$/,
+      '设备“$1”：安装高度已限制为 $2 m；插座安装范围为 [$3, $4] m',
+    )
+    .replace(
+      /^wall ([\s\S]+): receptacle spacing exceeds NEC 210\.52 \(moved outlet leaves a >12ft gap\)$/,
+      '墙体 $1：插座间距超过 NEC 210.52 要求（移动插座后留下大于 12 英尺的间距）',
+    )
+    .replace(
