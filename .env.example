# Optional environment variables

# Dev server port (default: 3002, set in .env.defaults)
# PORT=3002

# Public editor origin used by Mint OAuth and same-origin checks.
# Set this when Pascal is hosted outside editor.pascal.app.
# MINT_PASCAL_HOST_ORIGIN=https://pascal.example.com

# Phone/tablet pairing is disabled for the desktop-first release.
# To restore its UI, page and APIs, set true before building and rebuild/restart.
# NEXT_PUBLIC_DIASTAGE_DEVICE_LINK_ENABLED=false

# Account authentication uses the same origin as the website.
# Local default: http://127.0.0.1:4329. Public sites must use HTTPS.
# BETTER_AUTH_URL=https://diastage.example.com
# Required for public sites: a random server-only secret of at least 32 characters.
# BETTER_AUTH_SECRET=
# Without a secret on loopback, one is persisted beside the scene database.
# PASCAL_DB_PATH=/absolute/private/data/pascal.db
# PASCAL_DATA_DIR=/absolute/private/data
